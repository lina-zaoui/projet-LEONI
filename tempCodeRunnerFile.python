import json
from pathlib import Path

JSON_PATH = Path(
    r"C:\Users\Administrator\Desktop\stage-LEONI\projet-LEONI\data\output-model1\cable-seg\results\model1_results.json"
)

with open(JSON_PATH, "r", encoding="utf-8") as f:
    data = json.load(f)

print("=" * 70)
print("MODEL 1 RESULTS JSON")
print("=" * 70)

print("Type:", type(data))

if isinstance(data, dict):
    print("\nTop-level keys:")
    for key in data.keys():
        print("  ", key)

elif isinstance(data, list):
    print("\nNumber of entries:", len(data))

print("\nFirst entry:")
print(json.dumps(
    data[0] if isinstance(data, list) else data,
    indent=4
)[:10000])

print("=" * 70)